# ── Facebook / Meta ────────────────────────────────────────────────────────────
# Your Page ID (Page → About → Page transparency, or from the Graph API).
META_PAGE_ID=
# Page access token (Messenger → Settings → Access Tokens → Generate Token).
# Verify at https://developers.facebook.com/tools/debug/accesstoken/ → "Expires: Never".
META_PAGE_TOKEN=
# App ID and App Secret (App Dashboard → Settings → Basic).
META_APP_ID=
META_APP_SECRET=
# Random string you invent; paste the same value when registering the webhook.
META_VERIFY_TOKEN=change-me-to-something-random

# ── Claude API ────────────────────────────────────────────────────────────────
# Required. From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# BOT_* names are used on purpose: CLAUDE_* / ANTHROPIC_MODEL are common shell
# variables from other tools and must not leak into this bot's configuration.
BOT_MODEL=claude-opus-5-5
# low | medium | high  (low is cheapest; medium ~2x but sharper negotiation)
BOT_EFFORT=low

# ── Server / tunnel ───────────────────────────────────────────────────────────
PORT=3000
# Public HTTPS URL from Tailscale Funnel (no trailing slash), e.g.
# https://my-mac.tailnet-abc123.ts.net
WEBHOOK_PUBLIC_URL=
GRAPH_API_VERSION=v23.0

# ── Owner notifications (optional but recommended) ────────────────────────────
# Free phone push: install the ntfy app, pick a secret topic name, put it here.
# Example: https://ntfy.sh/my-shop-orders-x7k2
NOTIFY_URL=
# Your personal PSID (leave empty — the bot captures it via OWNER_SETUP_CODE).
OWNER_PSID=
# Change this to your own random code, then send it to your Page once from your
# personal account. Whoever sends it first becomes the owner, so don't share it.
OWNER_SETUP_CODE=OWNER-4821-7396

# ── Testing ───────────────────────────────────────────────────────────────────
# 1 = never call Claude, reply with a canned message (for setup testing).
DRY_RUN=0
